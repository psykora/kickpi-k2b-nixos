# KickPi K2B v2.2 (Allwinner H618) - lean headless-server kernel fragment.
# Used as `configfile` for pkgs.linuxManualConfig: nixpkgs links this as .config
# and runs `make oldconfig`, which fills every symbol not listed here with its
# Kconfig default (= same baseline as `make alldefconfig`).
# So this file is the DELTA from a sane default kernel, not a full .config.
#
# Validated against Linux 6.18.63 (alldefconfig + merge + olddefconfig loop).
#
# Deliberately kept (not "extreme minimal"): full crypto stack + arm64 CE
# accelerators + sun8i-ce engine, WireGuard, serial (8250 + PL011), I2C + PMIC,
# USB serial adapters (Zigbee/Z-Wave sticks), HID.
# Cut: DRM/GPU, sound, media/IR, wireless/BT, staging, most debug/ftrace,
# EFI/ACPI/PCI, CMA.

# ---------------------------------------------------------------- platform
CONFIG_ARCH_SUNXI=y
# clocks
CONFIG_SUN50I_H616_CCU=y
CONFIG_SUN50I_H6_R_CCU=y            # merged H6+H616 PRCM CCU symbol in 6.18 (was SUN50I_H616_R_CCU)
CONFIG_SUN6I_RTC_CCU=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SUNXI=y
# pinctrl / gpio
CONFIG_PINCTRL_SUN50I_H616=y
CONFIG_PINCTRL_SUN50I_H616_R=y
# dma
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN6I=y                  # verified: correct symbol name in 6.18
# rtc / watchdog / thermal / cpufreq / hwmon
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_HWMON=y
CONFIG_SUN8I_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y   # verified: correct symbol name in 6.18
# nvmem: stable MAC address from chip SID
CONFIG_NVMEM=y
CONFIG_NVMEM_SUNXI_SID=y

# ---------------------------------------------------------------- i2c + PMIC (AXP313A)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MV64XXX=y
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_AXP20X=y

# ---------------------------------------------------------------- leds
CONFIG_NEW_LEDS=y                   # gate for all LEDS_* symbols (default n)
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# ---------------------------------------------------------------- serial / input / hid
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y             # DesignWare 8250 quirks (sunxi UARTs); auto-selects SERIAL_8250_DWLIB
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_USB_HID=y

# ---------------------------------------------------------------- ethernet (dwmac-sun8i + Maxio MAE0621A)
CONFIG_NETDEVICES=y                 # gate for ETHERNET/PHYLIB/VETH/TUN/WIREGUARD (default n)
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_PHYLIB=y
CONFIG_MDIO_BUS=y                   # MDIO_DEVICE removed in 6.18 (folded into MDIO_BUS)
CONFIG_MAXIO_PHY=y                  # from maxio-mae0621a patch

# ---------------------------------------------------------------- usb host (HA dongles, storage)
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_ACM=y                    # CDC-ACM sticks
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=y          # Sonoff ZBDongle-P, many Z-Wave sticks
CONFIG_USB_SERIAL_FTDI_SIO=y        # ConBee II & co
CONFIG_USB_SERIAL_CH341=y           # Sonoff ZBDongle-E
CONFIG_USB_SERIAL_PL2303=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_NOP_USB_XCEIV=y

# scsi disk layer for usb-storage
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ---------------------------------------------------------------- mmc/sd (boot storage)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y

# ---------------------------------------------------------------- network core
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y            # gate: needed for the DEFAULT_* qdisc choice
CONFIG_DEFAULT_FQ_CODEL=y           # verified: exists in 6.18 (choice gated by NET_SCH_DEFAULT)

# ---------------------------------------------------------------- firewall (nftables), NAT, containers
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
# NF_TABLES_NAT removed in 6.18: nft nat chains come with NFT_NAT below
CONFIG_NF_TABLES_BRIDGE=y
# NFT_COUNTER removed in 6.18: counter expression is builtin to nf_tables
CONFIG_NFT_CT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_COMPAT=y                 # iptables-nft compat (docker/podman)
CONFIG_BRIDGE=y

# NixOS networking.firewall (iptables-compat ruleset) needs these xt matches/targets:
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_MATCH_RPFILTER=y

# podman/netavark support: xtables matches + iptables/ip6tables backends
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y   # gate for legacy iptables tables (default n)
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y   # renamed from NETFILTER_XT_MASQUERADE in 6.18
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y      # new 6.18 gate; required for IP_NF_FILTER/MANGLE/NAT
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y     # new 6.18 gate; required for IP6_NF_FILTER/MANGLE/NAT
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_VLAN_8021Q=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_BPF_SYSCALL=y
# CONFIG_BPF_LSM dropped: in 6.18 it needs BPF_EVENTS -> KPROBE_EVENTS
# (KPROBES+FTRACE) or UPROBE_EVENTS (PERF_EVENTS), which this config trims away.
CONFIG_CGROUP_BPF=y

# ---------------------------------------------------------------- filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y               # for compress_algorithm=zstd on /nix/store
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y
CONFIG_FS_ENCRYPTION=y              # ext4/f2fs crypto (needs crypto algos below)
CONFIG_BLK_DEV_LOOP=y
CONFIG_AUTOFS_FS=y                  # systemd automount (silences modprobe autofs4)

# ---------------------------------------------------------------- initramfs / devtmpfs (NixOS stage-1)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_RD_LZ4=y
CONFIG_RD_XZ=y
CONFIG_RD_LZMA=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_UNIX98_PTYS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PROC_SYSCTL=y

# ---------------------------------------------------------------- systemd requirements (cgroups, namespaces)
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y                      # verified: still exists in 6.18
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y                    # verified: still exists in 6.18
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FILE_LOCKING=y

# ---------------------------------------------------------------- security / lsm (NixOS: lsm=landlock,yama,bpf)
CONFIG_EXPERT=y                     # unhides expert prompts (VT=n, DEBUG_INFO_NONE); side effect: DEBUG_KERNEL=y via select
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_AUDIT=y
CONFIG_KEYS=y

# ---------------------------------------------------------------- crypto (kept per request: full default stack + arm64 accel + HW engine)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_CRC32C=y
# arm64 accelerated implementations
CONFIG_CRYPTO_AES_ARM64_CE=y
# SHA1/SHA2 arm64-CE symbols removed in 6.18: CE acceleration for SHA-1/SHA-2
# is now automatic via CRYPTO_LIB_SHA1/CRYPTO_LIB_SHA256 + CRYPTO_LIB_*_ARCH
# (both default y on ARM64 with KERNEL_MODE_NEON).
CONFIG_CRYPTO_GHASH_ARM64_CE=y
# Allwinner HW crypto engine (sun8i-ce)
CONFIG_CRYPTO_ENGINE=y
CONFIG_CRYPTO_DEV_SUN8I_CE=y

# ---------------------------------------------------------------- sizing / trimming
CONFIG_NR_CPUS=4
CONFIG_HZ_250=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y                   # embed config -> /proc/config.gz on the board
CONFIG_IKCONFIG_PROC=y

# mmap ASLR ranges (NixOS sysctl module greps these from the configfile
# to generate 55-nixos-aslr-entropy.conf; values = arm64 defaults)
CONFIG_ARCH_MMAP_RND_BITS_MAX=33
CONFIG_ARCH_MMAP_RND_COMPAT_BITS_MAX=16

# ---------------------------------------------------------------- off: debug & big subsystems
CONFIG_RANDOMIZE_BASE=n             # KASLR off: faster boot, no forced KPTI
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_KERNEL=n removed: forced =y when CONFIG_EXPERT=y (select DEBUG_KERNEL)
CONFIG_FTRACE=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_KPROBES=n
CONFIG_EFI=n
CONFIG_ACPI=n
CONFIG_PCI=n
CONFIG_DMA_CMA=n                    # frees the 32 MiB CMA reservation
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_VT=n                         # headless: serial console only
CONFIG_MEDIA_SUPPORT=n              # kills sunxi-ir, cedrus, cec
CONFIG_WIRELESS=n
CONFIG_WLAN=n                       # gate exists (NET=y); default y would enable all vendor menus
CONFIG_RFKILL=n
CONFIG_BT=n
CONFIG_STAGING=n
CONFIG_VIRTUALIZATION=n
